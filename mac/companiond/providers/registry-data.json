    {
      "id": "claude",
      "display_name": "Claude",
      "kind": "terminal_cli",
      "adapter_depth": "deep",
      "builtin": true,
      "binary_name": "claude",
      "binary_candidates": [
        "~/.local/bin/claude",
        "/opt/homebrew/bin/claude",
        "/usr/local/bin/claude"
      ],
      "env_override": "PAIRLING_CLAUDE_BIN",
      "config_paths": [
        "~/.claude/settings.json"
